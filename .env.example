VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Facoltativa — la ricerca giochi nella Watchlist funziona comunque senza (usa IGDB,
# FreeToGame e CheapShark come fonti sempre attive, senza chiave). Con questa chiave
# RAWG si aggiunge come fonte extra. Chiave gratuita su https://rawg.io/apidocs
VITE_RAWG_API_KEY=

# Facoltativa — senza questa chiave la ricerca "Video" (film/serie) usa AniList come
# fallback (buono per anime, debole per film/serie occidentali). Con questa chiave usa
# TMDB, che copre molto meglio film e serie di ogni tipo. Chiave gratuita (v3 API key)
# su https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=

# --- Variabili SENZA prefisso VITE_ — lette solo dalla funzione serverless in api/,
# MAI dal codice del browser (Vite non le include nel bundle, appunto perché non hanno
# il prefisso VITE_). Su Vercel vanno messe in Settings → Environment Variables, non
# devono mai finire nel bundle pubblico del sito.

# Facoltative — senza queste due IGDB non contribuisce risultati alla ricerca giochi
# (restano comunque attive RAWG/FreeToGame/CheapShark). Si ottengono creando un'app
# gratuita su https://dev.twitch.tv/console (IGDB è di proprietà di Twitch/Amazon).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
