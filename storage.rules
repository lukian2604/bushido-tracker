rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Foto profilo: leggibile da chiunque sia autenticato (serve per i profili
    // pubblici degli amici in futuro), scrivibile solo dal proprietario.
    // delete separato da create/update: in cancellazione request.resource è null,
    // quindi un unico "allow write" con i controlli su size/contentType la bloccava
    // (foto profilo e copertine non si potevano mai eliminare).
    match /users/{uid}/profile.jpg {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
    }

    // Copertine caricate a mano per gli elementi della Watchlist: private, solo il
    // proprietario può leggerle/scriverle (a differenza della foto profilo, qui non
    // serve la visibilità pubblica).
    match /users/{uid}/watchlist-covers/{fileId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
